# mn.env — 몽골어 UI 용 **부분** 환경파일 (2026-10-29 신설)
#
# ⚠️⚠️ **이 파일은 ko.env/en.env 처럼 전체가 아니다.** `02_01_해외송금_수취인관리_old.yaml` 과
#   `01_01_로그인_정상_old.yaml` 이 참조하는 키만 들어 있다(33개). 다른 플로우를 `-lang mn` 으로
#   돌리면 **없는 키가 `${VAR}` 로 남아 maestro 가 또렷하게 죽는다** — 조용히 틀리지는 않는다.
#
# ⛔⛔ **몽골어 글자는 반드시 `\uXXXX` 로 적는다 — 그대로 쓰면 깨진다.** (2026-10-29 실측)
#   `maestro` 는 `.bat` 셰임을 거쳐 `cmd.exe` 로 실행되고, cmd 가 인자를 **MS949** 로 다시
#   인코딩한다. 기본 키릴(А-я)은 CP949 에 있어 살아남지만 **몽골어 전용 `ү`(U+04AF)·`ө`(U+04E9)·
#   `Ө`(U+04E8) 는 없어서 `?` 로 바뀐다.**
#     실제로 `Гадаад шилжүүлэг` 가 `Гадаад шилж??лэг` 로 넘어가 "Element not found" 로 죽었다.
#   → 값은 전부 ASCII 로만 보내고, maestro 쪽에서 Java 정규식이 `\uXXXX` 를 풀게 한다.
#     (maestro 의 text 매칭은 정규식이다 — 평문처럼 보이는 값도 정규식으로 컴파일된다)
#   ⛔ 읽기 좋으라고 키릴을 그대로 되돌리지 말 것. 각 줄 위 주석에 사람이 읽는 값을 적어 둔다.
#
# 표기 규칙
#   ★ = 실기기에서 본 값 / ⚠️ = APK 리소스에서 뽑았고 화면 미확인 / ⛔ = 몽골어 값을 못 구했다
#
# ★ **값은 `몽골어|한국어` 양쪽 매칭으로 둔다.** 앱이 Lokalise OTA 라 APK 값과 화면 값이
#   다른 일이 실제로 있었고(`은행 입금` → 화면은 `계좌 입금`), 한쪽만 박으면 거기서 죽는다.
#   UI 가 몽골어면 한국어 쪽은 어차피 화면에 없으므로 **느슨하게 받아도 거짓 통과가 되지 않는다.**
#
# ⛔ **보안 키보드 라벨(PW_K*)과 `TRANSKEY_INPUT_COMPLETE` 는 앱 언어가 아니라 기기 언어를 따른다.**
#   앱을 몽골어로 바꿔도 그대로 한국어다 → 번역하지 말 것.

# ---- 공통 진입 / 로그인 ----
# 러너(-Build/-AppId)가 덮어쓴다. 자리만 지킨다
APP_ID=com.gmeremit.online.gmeremittance_native.stag
# 러너(-Server)가 덮어쓴다
SERVER_PICK=.*livetest.*
# ⚠️ mn 은 APK(enter_four_digit_text) 출처
#   (사람이 읽는 값: .*(4-оронтой|4자리 숫자를 입력하세요|Enter the 4-digit number).*)
PIN_ENTER_4DIGIT=.*(4-\u043E\u0440\u043E\u043D\u0442\u043E\u0439|4자리 숫자를 입력하세요|Enter the 4-digit number).*
# ⚠️ mn 은 APK(create_new_simple_password) 출처
#   (사람이 읽는 값: .*(ПИН кодыг зохионо уу|간편 비밀번호를 생성|[Cc]reate.*[Ss]imple [Pp]assword).*)
LOCK_CREATE_PROMPT=.*(\u041F\u0418\u041D \u043A\u043E\u0434\u044B\u0433 \u0437\u043E\u0445\u0438\u043E\u043D\u043E \u0443\u0443|간편 비밀번호를 생성|[Cc]reate.*[Ss]imple [Pp]assword).*
# ⛔ mn 값을 못 구했다(Lokalise 동적 문구, APK 에 없다) — 몽골어 UI 에서는 이 가드가 **사실상 꺼진다.** 세션이 만료되면 뒤따르는 단언에서 죽으므로 조용한 통과는 아니다
#   (사람이 읽는 값: [\s\S]*(Нэвтрэх хугацаа|로그인 세션이 만료)[\s\S]*)
SESSION_EXPIRED=[\s\S]*(\u041D\u044D\u0432\u0442\u0440\u044D\u0445 \u0445\u0443\u0433\u0430\u0446\u0430\u0430|로그인 세션이 만료)[\s\S]*
# ⛔ 보안 키보드 = 기기 언어. 번역 금지
TRANSKEY_INPUT_COMPLETE=입력완료
# ⚠️ mn 은 APK(fingerprint_auth_prompt_title_text) 출처
#   (사람이 읽는 값: .*(хурууны хээ|지문인증).*)
FINGERPRINT_AUTH_PROMPT_TITLE_TEXT=.*(\u0445\u0443\u0440\u0443\u0443\u043D\u044B \u0445\u044D\u044D|지문인증).*
# ⚠️ mn 은 APK(careful_voice) 출처
#   (사람이 읽는 값: .*(залилангаас|보이스 피싱).*)
REG_VOICE_PHISHING=.*(\u0437\u0430\u043B\u0438\u043B\u0430\u043D\u0433\u0430\u0430\u0441|보이스 피싱).*
# ⚠️ APK(later_text) 출처
#   (사람이 읽는 값: Дараа|나중에)
REG_LATER=\u0414\u0430\u0440\u0430\u0430|나중에
# ⚠️ APK 에 후보가 둘(ask_me_later_text / do_it_later) — 둘 다 받는다
#   (사람이 읽는 값: .*(Дараагийн удаа|Дараа хийх|나중에 하기).*)
ASK_ME_LATER_TEXT=.*(\u0414\u0430\u0440\u0430\u0430\u0433\u0438\u0439\u043D \u0443\u0434\u0430\u0430|\u0414\u0430\u0440\u0430\u0430 \u0445\u0438\u0439\u0445|나중에 하기).*

# ---- 해외송금 수취인 ([05] 몽골 경로) ----
# ★ 홈 타일 `title` 실측(2026-10-29). APK(main_overseas_transfer) 와도 같다
#   (사람이 읽는 값: Гадаад шилжүүлэг|해외송금)
TXT_OVERSEAS_REMIT=\u0413\u0430\u0434\u0430\u0430\u0434 \u0448\u0438\u043B\u0436\u04AF\u04AF\u043B\u044D\u0433|해외송금
# ⚠️ APK(who_do_you_want_to_send_it_to_text) 출처
#   (사람이 읽는 값: .*(Хэн рүү илгээх вэ|수취인을 선택하세요).*)
SCR_SELECT_RECIPIENT=.*(\u0425\u044D\u043D \u0440\u04AF\u04AF \u0438\u043B\u0433\u044D\u044D\u0445 \u0432\u044D|수취인을 선택하세요).*
# ★ 사용자 제공 스크린샷의 화면 제목과 일치(add_recipient_text)
#   (사람이 읽는 값: Хүлээн авагч нэмэх|수취인 추가하기)
ADD_RECIPIENT_TEXT=\u0425\u04AF\u043B\u044D\u044D\u043D \u0430\u0432\u0430\u0433\u0447 \u043D\u044D\u043C\u044D\u0445|수취인 추가하기
# ★ ko 는 실측 "계좌 입금" / mn 은 스크린샷의 "Банкны дансаар авах". APK 의 ko("은행 입금")는 화면에 안 쓰인다
#   (사람이 읽는 값: .*(Банкны дансаар авах|계좌 입금|은행 입금|Bank Deposit).*)
BANK_DEPOSIT_TEXT=.*(\u0411\u0430\u043D\u043A\u043D\u044B \u0434\u0430\u043D\u0441\u0430\u0430\u0440 \u0430\u0432\u0430\u0445|계좌 입금|은행 입금|Bank Deposit).*
# ★ 스크린샷의 '관계' 값과 일치(self_text)
#   (사람이 읽는 값: Өөрөө|본인)
SELF_TEXT=\u04E8\u04E9\u0440\u04E9\u04E9|본인
# ★ 스크린샷의 '송금 사유' 값과 일치(salary_wages_text)
#   (사람이 읽는 값: Цалин / Хөдөлмөрийн хөлс|급여 / 임금)
SALARY_WAGES_TEXT=\u0426\u0430\u043B\u0438\u043D / \u0425\u04E9\u0434\u04E9\u043B\u043C\u04E9\u0440\u0438\u0439\u043D \u0445\u04E9\u043B\u0441|급여 / 임금
# ⚠️ APK(yes) 출처. 수취인 삭제 확인에 쓴다
#   (사람이 읽는 값: Тийм|예)
BTN_YES=\u0422\u0438\u0439\u043C|예
# ⚠️ APK(check) 출처
#   (사람이 읽는 값: .*(Батлах|확인|OK).*)
BTN_CONFIRM=.*(\u0411\u0430\u0442\u043B\u0430\u0445|확인|OK).*
# ⚠️ APK(error_icon_content_description) 출처
#   (사람이 읽는 값: .*(Алдаа|오류).*)
ERROR_ICON_CONTENT_DESCRIPTION=.*(\u0410\u043B\u0434\u0430\u0430|오류).*
# ⚠️ APK(friend_text) 출처
#   (사람이 읽는 값: Найз|친구)
FRIEND_TEXT=\u041D\u0430\u0439\u0437|친구

# ---- 같은 파일의 다른 케이스가 참조하는 키 ----
# ⛔ 아래는 [05] 경로에서 쓰이지 않아 **몽골어 UI 에서 한 번도 확인되지 않았다.**
#   `-lang mn` 으로 [01]~[04] 를 돌리려면 화면을 보고 먼저 채울 것.
# ⚠️ APK(send_now_text) 출처
#   (사람이 읽는 값: Одоо илгээх|실시간 송금)
SEND_NOW_TEXT=\u041E\u0434\u043E\u043E \u0438\u043B\u0433\u044D\u044D\u0445|실시간 송금
# ⚠️ APK(calculate_text) 출처
#   (사람이 읽는 값: Тооцоолох|계산하기)
CALCULATE_TEXT=\u0422\u043E\u043E\u0446\u043E\u043E\u043B\u043E\u0445|계산하기
# ⚠️ APK(setting_text) 출처
#   (사람이 읽는 값: .*(Тохиргоо|설정).*)
CH_COMMON_SETTINGS=.*(\u0422\u043E\u0445\u0438\u0440\u0433\u043E\u043E|설정).*
# ⚠️ APK(continue_text) 출처
#   (사람이 읽는 값: .*(Үргэлжлүүлэх|계속).*)
MYQR_CONTINUE=.*(\u04AE\u0440\u0433\u044D\u043B\u0436\u043B\u04AF\u04AF\u043B\u044D\u0445|계속).*
# ⚠️ APK(transaction_detail_text) 출처
#   (사람이 읽는 값: .*(Гүйлгээний дэлгэрэнгүй|거래 상세 내역).*)
TRANSACTION_DETAIL_TEXT=.*(\u0413\u04AF\u0439\u043B\u0433\u044D\u044D\u043D\u0438\u0439 \u0434\u044D\u043B\u0433\u044D\u0440\u044D\u043D\u0433\u04AF\u0439|거래 상세 내역).*
# ⚠️ APK(yes) 출처
#   (사람이 읽는 값: ^(Тийм|예)$)
SEND_SAVED_YES=^(\u0422\u0438\u0439\u043C|예)$
# ⛔ mn 미확인
#   (사람이 읽는 값: .*(Үргэлжлүүлэх|үлдэгдэл|계속|잔액이 부족|최소 송금|한도).*)
SEND_CALC_RESULT_ANY=.*(\u04AE\u0440\u0433\u044D\u043B\u0436\u043B\u04AF\u04AF\u043B\u044D\u0445|\u04AF\u043B\u0434\u044D\u0433\u0434\u044D\u043B|계속|잔액이 부족|최소 송금|한도).*
# ⛔ mn 미확인
#   (사람이 읽는 값: .*(үлдэгдэл хүрэлцэхгүй|잔액이 부족).*)
SEND_INSUFFICIENT_BALANCE=.*(\u04AF\u043B\u0434\u044D\u0433\u0434\u044D\u043B \u0445\u04AF\u0440\u044D\u043B\u0446\u044D\u0445\u0433\u04AF\u0439|잔액이 부족).*
# ⛔ mn 미확인
#   (사람이 읽는 값: .*(амжилттай|алдаа|үлдэгдэл|성공|완료|잔액|실패|오류).*)
SEND_RESULT_ANY=.*(\u0430\u043C\u0436\u0438\u043B\u0442\u0442\u0430\u0439|\u0430\u043B\u0434\u0430\u0430|\u04AF\u043B\u0434\u044D\u0433\u0434\u044D\u043B|성공|완료|잔액|실패|오류).*
# ⛔ mn 미확인
#   (사람이 읽는 값: .*(үлдэгдэл|잔액).*)
SEND_RESULT_INSUFFICIENT=.*(\u04AF\u043B\u0434\u044D\u0433\u0434\u044D\u043B|잔액).*
# ⛔ mn 미확인
#   (사람이 읽는 값: .*(амжилттай|성공|완료).*)
SEND_SUCCESS=.*(\u0430\u043C\u0436\u0438\u043B\u0442\u0442\u0430\u0439|성공|완료).*

# ---- 언어 전환 헬퍼용(이 경로에서는 동작하지 않게 둔다) ----
# ko.env 와 같다 — 헬퍼를 재우는 값
LANG_SWITCH_TRIGGER=__NEVER_MATCH__
# ko.env 와 같다
LANG_SWITCH_TARGET=Korean
