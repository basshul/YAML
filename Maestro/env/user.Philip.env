# 사용자 프로파일 — Philip
#
# 형식과 주의사항은 `user.Basshu.env` 머리말 참고(그쪽이 정본 설명이다).
# 이 파일은 maestro 와 web-runner 의 admin 점검이 **함께** 읽는다.
#
# ⛔ **아직 실행에 쓰지 말 것.** 1단계에서 변수화한 것은 **계정 ID 뿐**이다.
#   PIN·로그인 비밀번호는 여전히 Basshu 의 값이 탭 시퀀스로 박혀 있어
#   이 프로파일로 돌리면 **로그인 단계에서 실패한다.**
#   2단계(자격정보 헬퍼화)가 끝나야 실제로 쓸 수 있다.

ACCT_MAIN=sphh

# ── 역할 계정 ───────────────────────────────────────────────────────────
# 비워 두면 admin 사전 점검이 **그 항목을 건너뛴다**. 없는 계정을 찾으라고
# 시켜서 가짜 NG 를 만들지 않기 위해서다. 계정이 생기면 값을 채운다.
ACCT_FOREIGN=
ACCT_GMEPAY=
ACCT_SIGNUP_1=
ACCT_SIGNUP_2=

# ── 2단계에서 채울 것 ───────────────────────────────────────────────────
# PIN_NORMAL=        # 간편 비밀번호 4자리
# PW_LOGIN=          # 로그인 비밀번호
# ACCT_MAIN_NAME=    # 표시 이름. `03_Domestic` 이 수취인으로 탭한다(Basshu=LEE SEUNGSOO)
