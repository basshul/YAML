# ================================================================
# 공통 (2026-08-12 추가)
# 출처: APK 리소스 추출 (livetest 2026-04-29, aapt2 dump resources / () = 영문 기본값)
#       ※ 실기기 영어 모드 미검증. Lokalise OTA 로 서버가 다른 문구를 내릴 수 있음.
# ================================================================
# 앱 최초 실행/권한
# select_language / select_language_text 두 리소스가 대소문자만 달라 정규식으로 양쪽 수용
INIT_SELECT_LANGUAGE=Select [Ll]anguage
INIT_SERVICE_GUIDE=Guide for using the service
# ⚠ OS 권한 다이얼로그는 기기 언어를 따르므로 ko.env 와 동일 값
SYS_PERMISSION_ALLOW=허용|Allow

# 간편비밀번호 / 세션
PIN_ENTER_4DIGIT=Enter the 4-digit number
# ⚠ APK 리소스에 대응 문자열 없음(OTA 추정) → 영어 실행 시 이 가드는 발동하지 않는다.
#   기존 영어 동작과 동일. 실기기에서 실제 문구 확인되면 교체할 것.
SESSION_EXPIRED=__NEVER_MATCH__

# 홈 공통
HOME_EXIT_CONFIRM=Would you like to exit?
# close_text 는 소문자, ch.settings.close 는 대문자라 정규식으로 양쪽 수용
BTN_CLOSE=[Cc]lose

# ================================================================
# 앱 패키지 (빌드 전환용)
# ================================================================
# yaml의 `appId: ${APP_ID}` 에 주입된다.
#
# ★ 2026-09-03 사용자 선언 — **livetest 빌드는 더 이상 쓰지 않는다.**
#   기본        : `.stag` 빌드로 구동하고 **서버를 LIVETEST로 지정**해서 테스트한다.
#   운영(Live)  : 요청이 있을 때만 `com.gmeremit.online.gmeremittance_native`(접미사 없음).
#   → 기기에서 `.livetest` 패키지는 **이미 삭제됐다**(2026-09-03 adb 확인). 되살리지 말 것.
#
# ⚠️ stag 빌드는 Server Override 기본값이 **STAG**다. `clearState`가 그 기본값으로
#   초기화하므로 **매 launchApp 뒤에 LIVETEST를 코드로 강제**해야 한다
#   (`_server_override_old.yaml` 또는 동일한 인라인 항등 시퀀스).
#   안 하면 전 스위트가 조용히 gmeuat(STAG)로 돈다 — 2026-08-27 실제 사고.
#   검증은 접속 호스트로 한다: adb logcat -d | grep -oE '(livetest|gmeuat)\.gmeremit\.com'
#
# 러너에서 바꾸는 법: `-Build stag`(기본) / `-Build live` / 임의 패키지는 `-AppId <pkg>`
APP_ID=com.gmeremit.online.gmeremittance_native.stag
