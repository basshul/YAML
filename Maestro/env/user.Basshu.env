# 사용자 프로파일 — Basshu
#
# 무엇인가: 사람마다 다른 **테스트 데이터**. 화면 문구는 `ko.env`/`en.env` 가 담당하고
#   이 파일은 "누구로 테스트하는가" 에 해당하는 값만 담는다. 키가 겹치지 않으므로
#   두 파일을 함께 올려도 maestro 가 헷갈리지 않는다.
#
# 쓰는 법: `run_test.ps1 -User Basshu ...` / `run_suite.ps1 -User Basshu ...`
#   (기본값은 Basshu 다 — 종전 동작을 그대로 유지하기 위해서다)
#
# ★ 이 파일은 **maestro 와 web-runner 의 admin 점검이 함께 읽는다.**
#   계정이 두 군데에 적히면 반드시 어긋난다 → 정체성은 여기 한 곳에만 둔다.
#
# ⚠️ 값은 반드시 `KEY=VALUE` 한 줄. 값에 `|` `&` `<` `>` 가 들어가면 인용 없이는
#   cmd 가 셸 연산자로 해석해 실행이 죽는다(러너가 인용해서 넘기지만, 되도록 피할 것).
#
# ── 1단계 범위 ──────────────────────────────────────────────────────────
#   계정 ID 만 변수화했다. PIN·로그인 비밀번호는 **탭 시퀀스로 흩어져 있어**
#   별도 작업이 필요하다(2단계). 그때까지 사용자를 바꾸면 ID 는 바뀌지만
#   비밀번호·PIN 은 Basshu 의 것으로 들어간다 → **로그인이 실패한다.**
#   즉 지금은 Basshu 외 프로파일로 실제 실행하면 안 된다.
# ────────────────────────────────────────────────────────────────────────

# 주 계정 로그인 ID. `01_01` `04_02` `14_*` `_stag_login` 이 쓴다.
ACCT_MAIN=seungsoo818

# ── 역할 계정 ───────────────────────────────────────────────────────────
# admin 사전 점검이 이 값들로 대상을 정한다. **빈 값이면 그 점검을 건너뛴다**
# (아직 계정이 없는 사람에게 없는 계정을 찾으라고 시키지 않는다).
# ⛔ **줄 끝 주석을 쓰지 말 것** — 러너가 `=` 뒤를 줄 끝까지 전부 값으로 가져간다.
# 외국인·은행 미연결 (14_02 · 25_Profile_Foreign)
ACCT_FOREIGN=test123
# 외국인·GMEPay 신청완료 (14_03)
ACCT_GMEPAY=test251024

# 06_Registration 이 **소모하는** 계정 — 실행 전에 없어야 재실행이 된다.
ACCT_SIGNUP_1=test006
ACCT_SIGNUP_2=test007
